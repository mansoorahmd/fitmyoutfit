# Backend environment. `npm run setup` copies this file to backend/.env if it is missing.
# EVERY VALUE BELOW IS A DEV-ONLY DEFAULT. Never reuse any of them in staging or production.

# --- Database and cache (docker-compose.yml: PostgreSQL on host port 5433, Redis on 6379) ---
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa
REDIS_URL=redis://localhost:6379

# --- CORS ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# --- Secrets (DEV ONLY: change in production. The backend refuses to start in production without them.) ---
JWT_SECRET=dev-only-jwt-secret-change-in-production
COOKIE_SECRET=dev-only-cookie-secret-change-in-production

# --- File storage: S3 provider pointed at the local MinIO (docker-compose.yml). ---
# Leave all S3_* variables empty to use Medusa's local file provider instead.
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=fitmyoutfit-dev
S3_REGION=us-east-1
# MinIO dev credentials, the same as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FILE_URL=http://localhost:9100/fitmyoutfit-dev

# --- Public addresses, written into links the backend sends (the password-reset link). ---
# STOREFRONT_URL: where customers open the store. BACKEND_URL: where this backend (and its admin at
# /app) is reached. Origins only: nothing after the host and port. Outside development and test
# both must be set and use https, or the backend refuses to start. If you move the storefront or
# the backend to another port, change these too.
STOREFRONT_URL=http://localhost:8000
BACKEND_URL=http://localhost:9000

# --- Local admin user, created by the seed (`npm run setup`). DEV ONLY. ---
# Sign in at http://localhost:9000/app
MEDUSA_ADMIN_EMAIL=admin@fitmyoutfit.local
MEDUSA_ADMIN_PASSWORD=dev-admin-password
