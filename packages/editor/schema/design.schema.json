{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitmyoutfit.example/schemas/design.schema.json",
  "title": "FitMyOutfit design document",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "zones": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "required": [
          "id",
          "hex"
        ],
        "additionalProperties": false
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "family": {
            "type": "string",
            "pattern": "^[^\"'\\\\;{}<>\\p{Cc}]{1,100}$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "fallbackFontIds": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "family"
        ],
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "text"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\p{Cc}]*$",
                "description": "One line of text in any script, 1 to 200 UTF-16 code units. It must also be in Unicode NFC and hold a visible character, which this schema cannot check: validateDesign() from @fitmyoutfit/editor/design does."
              },
              "direction": {
                "type": "string",
                "enum": [
                  "auto",
                  "ltr",
                  "rtl"
                ]
              },
              "fontId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fill": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^#[0-9A-F]{6}$"
                  }
                },
                "required": [
                  "id",
                  "hex"
                ],
                "additionalProperties": false
              },
              "align": {
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "value",
              "direction",
              "fontId",
              "fontSize",
              "fill",
              "align"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "number"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^(?:[\\u0030-\\u0039]+|[\\u0660-\\u0669]+|[\\u06F0-\\u06F9]+)$",
                "description": "A jersey number: one or more digits from one digit system (Western 0-9, Arabic-Indic ٠-٩ or Extended Arabic-Indic ۰-۹), kept as typed so \"07\" survives. This pattern checks the structure only. The largest number (99, so at most 2 digits) is data, not part of the pattern, and is enforced by validateDesign() from @fitmyoutfit/editor/design, as are the allowed digit systems when the rules are changed. Do not rely on this schema alone to accept a number layer."
              },
              "fontId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fill": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^#[0-9A-F]{6}$"
                  }
                },
                "required": [
                  "id",
                  "hex"
                ],
                "additionalProperties": false
              },
              "align": {
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "value",
              "fontId",
              "fontSize",
              "fill",
              "align"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "logo"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "asset": {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                },
                "required": [
                  "assetId",
                  "width",
                  "height",
                  "mediaType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "asset"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "clipart"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "asset": {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp",
                      "image/svg+xml"
                    ]
                  }
                },
                "required": [
                  "assetId",
                  "width",
                  "height",
                  "mediaType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "asset"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "palette",
    "zones",
    "fonts",
    "layers"
  ],
  "additionalProperties": false
}
