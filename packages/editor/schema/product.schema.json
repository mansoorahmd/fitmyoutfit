{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitmyoutfit.example/schemas/product.schema.json",
  "title": "FitMyOutfit product definition",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "model": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "const": "glb"
        }
      },
      "required": [
        "url",
        "format"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "teamColors": {
      "type": "object",
      "properties": {
        "main": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "requested": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
            }
          },
          "required": [
            "id",
            "hex"
          ],
          "additionalProperties": false
        },
        "second": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "requested": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
            }
          },
          "required": [
            "id",
            "hex"
          ],
          "additionalProperties": false
        },
        "accent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "requested": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
            }
          },
          "required": [
            "id",
            "hex"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "main",
        "second"
      ],
      "additionalProperties": false
    },
    "views": {
      "type": "object",
      "properties": {
        "front": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "back": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "front",
        "back"
      ],
      "additionalProperties": false
    },
    "pieces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "mesh": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uv": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "outline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "^[MmLlHhVvCcQqZz0-9eE.,+\\-\\s]+$",
            "description": "The cut shape of the piece: one closed SVG path (M, L, H, V, C, Q, Z) in the piece's millimetres, inside its width and height. This pattern checks the characters only; validateProductDefinition() and validateDesign() from @fitmyoutfit/editor/design parse the path and check where it lies. Do not rely on this schema alone."
          },
          "printArea": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "zone": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "regions": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "zone": {
                  "type": "string",
                  "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "^[MmLlHhVvCcQqZz0-9eE.,+\\-\\s]+$",
                  "description": "SVG path data (M, L, H, V, C, Q, Z) in the piece's millimetres. May reach past the outline; only the part inside it counts. This pattern checks the characters only; validateProductDefinition() and validateDesign() from @fitmyoutfit/editor/design parse the path and check where it lies. Do not rely on this schema alone."
                }
              },
              "required": [
                "zone",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "mesh",
          "width",
          "height",
          "uv",
          "outline",
          "zone",
          "regions"
        ],
        "additionalProperties": false
      }
    },
    "zones": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "defaultColor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              }
            },
            "required": [
              "id",
              "hex"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "defaultColor"
        ],
        "additionalProperties": false
      }
    },
    "placements": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "pieceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "centre": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "maxSize": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "team-name",
                "player-name",
                "player-number",
                "crest",
                "sponsor",
                "text",
                "graphic"
              ]
            }
          },
          "side": {
            "type": "string",
            "enum": [
              "front",
              "back",
              "left",
              "right"
            ]
          },
          "fontSize": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "pieceId",
          "centre",
          "maxSize",
          "roles",
          "side"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "model",
    "palette",
    "teamColors",
    "views",
    "pieces",
    "zones",
    "placements"
  ],
  "additionalProperties": false
}
