{
  "name": "@fitmyoutfit/editor",
  "version": "0.0.0",
  "private": true,
  "description": "3D design editor for custom apparel. A design is a JSON document; this package renders it and validates it.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./design": {
      "import": {
        "types": "./dist/types/design/index.d.ts",
        "default": "./dist/design.js"
      },
      "require": {
        "types": "./dist/cjs/types/index.d.ts",
        "default": "./dist/cjs/design.cjs"
      }
    },
    "./design.schema.json": "./schema/design.schema.json",
    "./product.schema.json": "./schema/product.schema.json",
    "./font-catalog.schema.json": "./schema/font-catalog.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && vite build --config vite.design-cjs.config.ts && tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package.mjs && node scripts/check-entrypoints.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "generate:model": "tsx scripts/generate-placeholder-jersey.ts",
    "generate:templates": "tsx scripts/make-sample-templates.ts",
    "process:stand-in": "tsx scripts/process-stand-in-model.ts",
    "dev:lan": "vite --config vite.demo.config.ts --host"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/graduate": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
