{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitmyoutfit.example/schemas/design.schema.json",
  "title": "FitMyOutfit design document",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "zones": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "required": [
          "id",
          "hex"
        ],
        "additionalProperties": false
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          }
        },
        "required": [
          "id",
          "family"
        ],
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "text"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "fontId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fill": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^#[0-9A-F]{6}$"
                  }
                },
                "required": [
                  "id",
                  "hex"
                ],
                "additionalProperties": false
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "value",
              "fontId",
              "fontSize",
              "fill",
              "align"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "number"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9]{1,3}$"
              },
              "fontId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fill": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^#[0-9A-F]{6}$"
                  }
                },
                "required": [
                  "id",
                  "hex"
                ],
                "additionalProperties": false
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "value",
              "fontId",
              "fontSize",
              "fill",
              "align"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "logo"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "asset": {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "image/svg+xml",
                      "image/png",
                      "image/jpeg"
                    ]
                  }
                },
                "required": [
                  "assetId",
                  "mediaType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "asset"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "clipart"
              },
              "pieceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "size": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "rotation": {
                "type": "number"
              },
              "asset": {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "image/svg+xml",
                      "image/png",
                      "image/jpeg"
                    ]
                  }
                },
                "required": [
                  "assetId",
                  "mediaType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "pieceId",
              "position",
              "size",
              "rotation",
              "asset"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "palette",
    "zones",
    "fonts",
    "layers"
  ],
  "additionalProperties": false
}
