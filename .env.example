# Root environment, read by docker-compose.yml. `npm run setup` copies this file to .env if it is missing.
# EVERY VALUE BELOW IS A DEV-ONLY DEFAULT.
#
# If you change a host port here, change the matching URL in backend/.env too
# (DATABASE_URL, REDIS_URL, S3_ENDPOINT, S3_FILE_URL), then run `docker compose up -d` again.

# Host ports (container ports do not change)
POSTGRES_PORT=5433
REDIS_PORT=6379
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# PostgreSQL (backend/.env DATABASE_URL must match)
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa

# MinIO (backend/.env S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_BUCKET must match)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fitmyoutfit-dev
