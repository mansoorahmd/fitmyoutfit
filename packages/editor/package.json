{
  "name": "@fitmyoutfit/editor",
  "version": "0.0.0",
  "private": true,
  "description": "3D design editor for custom apparel. A design is a JSON document; this package renders it and validates it.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./design": {
      "types": "./dist/types/design/index.d.ts",
      "import": "./dist/design.js"
    },
    "./design.schema.json": "./schema/design.schema.json",
    "./product.schema.json": "./schema/product.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/check-entrypoints.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "generate:model": "node scripts/generate-placeholder-jersey.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
