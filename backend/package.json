{
  "name": "@fitmyoutfit/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Medusa v2 backend for the FitMyOutfit custom apparel store.",
  "license": "UNLICENSED",
  "scripts": {
    "build:rules": "npm run build --prefix ../packages/team-rules",
    "prebuild": "npm run build:rules",
    "build": "medusa build",
    "predev": "npm run build:rules",
    "dev": "medusa develop",
    "start": "medusa start",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "lint": "eslint .",
    "pretypecheck": "npm run build:rules",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration:http",
    "pretest:unit": "npm run build:rules",
    "pretest:integration:http": "npm run build:rules",
    "pretest:integration:modules": "npm run build:rules",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@fitmyoutfit/team-rules": "file:../packages/team-rules",
    "@medusajs/admin-sdk": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/medusa": "2.22.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@medusajs/test-utils": "2.22.6",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=22"
  }
}
