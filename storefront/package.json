{
  "name": "@fitmyoutfit/storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Storefront for the FitMyOutfit custom apparel store",
  "scripts": {
    "ensure-editor": "node scripts/ensure-editor.mjs",
    "predev": "npm run ensure-editor",
    "dev": "node scripts/next-with-port.mjs dev --turbopack",
    "prebuild": "npm run ensure-editor",
    "build": "next build",
    "start": "node scripts/next-with-port.mjs start",
    "lint": "eslint src",
    "pretypecheck": "npm run ensure-editor",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run ensure-editor",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fitmyoutfit/editor": "*",
    "@headlessui/react": "^2.2.0",
    "@medusajs/icons": "2.22.6",
    "@medusajs/js-sdk": "2.22.6",
    "@medusajs/ui": "4.2.13",
    "@radix-ui/react-accordion": "^1.2.1",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "lodash": "^4.17.21",
    "next": "15.5.29",
    "pg": "^8.11.3",
    "qs": "^6.12.1",
    "react": "19.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0",
    "webpack": "^5"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@eslint/eslintrc": "^3.3.7",
    "@medusajs/types": "2.22.6",
    "@medusajs/ui-preset": "2.22.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.14.195",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-instantsearch-dom": "^6.12.3",
    "@vitejs/plugin-react": "^6.3.0",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "babel-loader": "^8.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.0.23",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
