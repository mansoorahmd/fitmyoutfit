    "shapes": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "const": "shape"
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "pieceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "^[MmLlHhVvCcQqZz0-9eE.,+\\-\\s]+$",
            "description": "SVG path data (M, L, H, V, C, Q, Z) in the piece's millimetres. May reach past the outline; only the part inside it is drawn. This pattern checks the characters only; validateProductDefinition() and validateDesign() from @fitmyoutfit/editor/design parse the path and check where it lies. Do not rely on this schema alone."
          },
          "fill": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "teamColor": {
                "type": "string",
                "enum": [
                  "main",
                  "second",
                  "accent"
                ]
              },
              "requested": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$",
                "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
              }
            },
            "required": [
              "id",
              "hex"
            ],
            "additionalProperties": false
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "group",
          "pieceId",
          "path",
          "fill",
          "locked"
        ],
        "additionalProperties": false
      }
    },
