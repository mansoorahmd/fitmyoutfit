{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitmyoutfit.example/schemas/font-catalog.schema.json",
  "title": "FitMyOutfit font catalogue",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fonts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "family": {
            "type": "string",
            "pattern": "^[^\"'\\\\;{}<>\\p{Cc}]{1,100}$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "scripts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "latin",
                "arabic"
              ]
            }
          },
          "fallbackFontIds": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "uses": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "text",
                "number"
              ]
            }
          },
          "licence": {
            "type": "object",
            "properties": {
              "spdx": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "copyright": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "package": {
                "type": "string",
                "minLength": 1,
                "maxLength": 214
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "spdx",
              "copyright",
              "package",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "family",
          "weight",
          "style",
          "scripts",
          "fallbackFontIds",
          "uses",
          "licence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "fonts"
  ],
  "additionalProperties": false
}
