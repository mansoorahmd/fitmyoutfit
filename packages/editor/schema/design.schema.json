{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitmyoutfit.example/schemas/design.schema.json",
  "title": "FitMyOutfit design document",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "teamColors": {
      "type": "object",
      "properties": {
        "main": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "requested": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
            }
          },
          "required": [
            "id",
            "hex"
          ],
          "additionalProperties": false
        },
        "second": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "requested": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
            }
          },
          "required": [
            "id",
            "hex"
          ],
          "additionalProperties": false
        },
        "accent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "requested": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$",
              "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
            }
          },
          "required": [
            "id",
            "hex"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "main",
        "second"
      ],
      "additionalProperties": false
    },
    "teamName": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\p{Cc}]*$"
    },
    "samplePlayer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\p{Cc}]*$"
        },
        "number": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^(?:[\\u0030-\\u0039]+|[\\u0660-\\u0669]+|[\\u06F0-\\u06F9]+)$",
              "description": "A jersey number: one or more digits from one digit system (Western 0-9, Arabic-Indic ٠-٩ or Extended Arabic-Indic ۰-۹), kept as typed so \"07\" survives. This pattern checks the structure only. The largest number (99, so at most 2 digits) is data, not part of the pattern, and is enforced by validateDesign() from @fitmyoutfit/editor/design, as are the allowed digit systems when the rules are changed. Do not rely on this schema alone to accept a number layer."
            }
          ]
        }
      },
      "required": [
        "name",
        "number"
      ],
      "additionalProperties": false
    },
    "template": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "zones": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          },
          "teamColor": {
            "type": "string",
            "enum": [
              "main",
              "second",
              "accent"
            ]
          },
          "requested": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$",
            "description": "The colour code the customer asked for (a code typed in the colour-code match), kept beside the palette colour it was matched to. Never printed: `id` and `hex` are the printed colour."
          }
        },
        "required": [
          "id",
          "hex"
        ],
        "additionalProperties": false
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "family": {
            "type": "string",
            "pattern": "^[^\"'\\\\;{}<>\\p{Cc}]{1,100}$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "fallbackFontIds": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "family"
        ],
        "additionalProperties": false
      }
