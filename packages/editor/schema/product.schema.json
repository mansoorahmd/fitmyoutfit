{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitmyoutfit.example/schemas/product.schema.json",
  "title": "FitMyOutfit product definition",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "model": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "const": "glb"
        }
      },
      "required": [
        "url",
        "format"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "pieces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "mesh": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uv": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "outline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "^[MmLlHhVvCcQqZz0-9eE.,+\\-\\s]+$",
            "description": "The cut shape of the piece: one closed SVG path (M, L, H, V, C, Q, Z) in the piece's millimetres, inside its width and height. This pattern checks the characters only; validateProductDefinition() from @fitmyoutfit/editor/design parses the path and checks the outline is closed, inside the piece and that zones exist. Do not rely on this schema alone."
          },
          "zone": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "regions": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "zone": {
                  "type": "string",
                  "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "^[MmLlHhVvCcQqZz0-9eE.,+\\-\\s]+$",
                  "description": "SVG path data (M, L, H, V, C, Q, Z) in the piece's millimetres. May reach past the outline; only the part inside it counts. This pattern checks the characters only; validateProductDefinition() from @fitmyoutfit/editor/design parses the path and checks the outline is closed, inside the piece and that zones exist. Do not rely on this schema alone."
                }
              },
              "required": [
                "zone",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "mesh",
          "width",
          "height",
          "uv",
          "outline",
          "zone",
          "regions"
        ],
        "additionalProperties": false
      }
    },
    "zones": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "defaultColor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              }
            },
            "required": [
              "id",
              "hex"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "defaultColor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "model",
    "palette",
    "pieces",
    "zones"
  ],
  "additionalProperties": false
}
